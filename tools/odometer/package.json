{
  "name": "token-odometer",
  "version": "1.0.0",
  "description": "Local-first dashboard for AI token usage: how fast each provider answers, how much the cache is saving you, and what every turn really costs.",
  "type": "module",
  "main": "server.mjs",
  "bin": {
    "token-odometer": "server.mjs",
    "token-odometer-stats": "stats.mjs"
  },
  "scripts": {
    "start": "node --no-warnings server.mjs",
    "stats": "node --no-warnings stats.mjs",
    "stats:watch": "node --no-warnings stats.mjs --watch",
    "test": "node tools/selftest.mjs",
    "selftest": "node tools/selftest.mjs --json",
    "reconcile": "node --no-warnings tools/reconcile.mjs"
  },
  "keywords": [
    "tokens",
    "llm",
    "observability",
    "dashboard",
    "claude-code",
    "codex",
    "opencode",
    "antigravity",
    "cache",
    "cost",
    "gemini-cli",
    "ccusage-alternative",
    "cost-tracking"
  ],
  "author": "Nishanth <dn8.porps@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {},
  "devDependencies": {},
  "private": false,
  "files": [
    "server.mjs",
    "stats.mjs",
    "store.mjs",
    "pricing.mjs",
    "collectors",
    "web",
    "assets",
    "tools",
    "docs"
  ]
}
