{
  "name": "@nishanth1812/cairn",
  "version": "0.1.1",
  "description": "Cairn Context: a local code index for AI coding agents.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nishanth1812/Cairn.git"
  },
  "bugs": {
    "url": "https://github.com/Nishanth1812/Cairn/issues"
  },
  "homepage": "https://github.com/Nishanth1812/Cairn#readme",
  "bin": {
    "cairn": "./bin/cairn.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist-next',{recursive:true,force:true})\"",
    "build": "tsc --noEmit && rolldown -c",
    "postbuild": "node -e \"const f=require('node:fs');f.copyFileSync('src/cairn/cli/waymark-compat.mjs','dist-next/waymark.js');try{f.renameSync('dist','dist-old')}catch{}f.renameSync('dist-next','dist');f.rmSync('dist-old',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/cairn",
    "test": "node --test \"tests/cairn/*.test.mjs\"",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "developer-tools",
    "ai-coding",
    "context",
    "indexing",
    "local-first",
    "telemetry",
    "tokens"
  ],
  "license": "GPL-3.0-only",
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "rolldown": "^1.2.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=24"
  }
}
